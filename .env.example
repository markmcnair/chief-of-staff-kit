# --- Beeper watcher (box / Linux host running Beeper Desktop) ---
BEEPER_URL=http://localhost:23373
BEEPER_TOKEN=your-beeper-desktop-api-token
BEEPER_WEBHOOK_URL=https://YOUR-GROK-BOT-WEBHOOK-ROUTINE-URL
BEEPER_WEBHOOK_SECRET=your-webhook-secret
WATCHER_POLL=10
# BEEPER_STATE_DIR=/path/for/state-and-logs   (default: the beeper/ folder)
# BEEPER_DISPLAY=:2
# BEEPER_APPIMAGE=$HOME/Applications/Beeper.AppImage

# --- MaxOS CLI ---
MAXOS_DB=./maxos/maxos.db
MAXOS_KIDS=kid1,kid2
MAXOS_GYM_DOW=1,3,5

# --- Supabase (only for the iMessage outbound path; set as function secrets, not on the Mac) ---
BRIDGE_SECRET=long-random-string
# The Mac bridge reads its settings from ~/.imessage-bridge/config.json (see imessage-bridge/config.example.json)
